# Ghost environment configuration
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Public URL of this Ghost instance
BASE_HOST_NAME=ghost.example.com

# Database (MySQL)
DB_CREATE_DATABASE_NAME=ghost
DB_USER_NAME=ghost
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Email / SMTP
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com
